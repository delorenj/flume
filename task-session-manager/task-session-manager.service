[Unit]
Description=Task Session Manager Service
Documentation=https://github.com/flume
After=network.target rabbitmq-server.service
Wants=rabbitmq-server.service

[Service]
Type=simple
User=taskmanager
Group=taskmanager
WorkingDirectory=/opt/task-session-manager

# Environment variables
Environment="RABBITMQ_URL=amqp://guest:guest@localhost:5672/"
Environment="RABBITMQ_EXCHANGE=task.lifecycle"
Environment="RABBITMQ_QUEUE=task.session.assigned"
Environment="RABBITMQ_ROUTING_KEY=task.lifecycle.assigned"
Environment="FLUME_SESSION_MANAGER=zellij"
Environment="LOG_LEVEL=info"
Environment="ENVIRONMENT=production"
Environment="HEALTH_CHECK_PORT=8080"

# Additional environment from file (optional)
EnvironmentFile=-/etc/task-session-manager/env

# Main process
ExecStart=/usr/local/bin/task-session-manager

# Restart policy
Restart=always
RestartSec=5s

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log/task-session-manager

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=task-session-manager

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
