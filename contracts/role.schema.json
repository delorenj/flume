{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/role.schema.json",
  "title": "Role frontmatter declaration",
  "type": "object",
  "required": ["role"],
  "properties": {
    "role": {"type": "string", "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"},
    "identity": {"$ref": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/named-agent.schema.json#/$defs/identity"},
    "skills": {"$ref": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/named-agent.schema.json#/$defs/skills"},
    "memory": {"$ref": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/named-agent.schema.json#/$defs/memory"},
    "department": {"type": "string", "minLength": 1},
    "reports_to": {"type": "string", "minLength": 1},
    "chain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^automaticai/[a-z0-9_-]+/[a-z0-9._-]+$"}}
  }
}
