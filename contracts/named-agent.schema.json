{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/named-agent.schema.json",
  "title": "Portable Named Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "role", "charter", "skills", "memory"],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,57}$"},
        "write_bank": {"type": "string"},
        "recall_banks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "skills": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["pack"]}, {"required": ["packs"]}, {"required": ["set"]}],
      "properties": {
        "pack": {"type": "string", "minLength": 1},
        "packs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "set": {"type": "string", "minLength": 1}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["write_bank"],
      "properties": {
        "write_bank": {"type": "string", "pattern": "^agent-[a-z0-9-_]+$"},
        "recall_banks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "id": {"$ref": "#/$defs/identity/properties/name"},
    "identity": {"$ref": "#/$defs/identity"},
    "display_name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"},
    "charter": {
      "type": "object", "additionalProperties": false, "required": ["purpose"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "directives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tone": {"type": "string", "minLength": 1}
      }
    },
    "skills": {"$ref": "#/$defs/skills"},
    "memory": {"$ref": "#/$defs/memory"},
    "desk": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    }
  }
}
