{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/delorenj/flume/main/contracts/employee-access.schema.json",
  "title": "Employee access facade contracts (version 1)",
  "description": "The versioned request an authenticated employee process sends to `flume access serve`, and the operator-authored configuration the facade and the trusted launcher read. The facade never writes the configuration: grants are approved by editing it, never through a request.",
  "$defs": {
    "request": {
      "title": "Access request (version 1)",
      "description": "Closed: an unknown key (for example a self-approval field) is refused. `employee` may only be absent or name the authenticated employee by handle or subject; it never selects who is asking.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "service", "resource", "permissions"],
      "properties": {
        "version": {"const": 1},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 256},
        "permissions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/*-]{0,63}$"}},
        "lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "employee": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "grant": {
      "title": "Pre-approved grant",
      "description": "Keyed by subject + service + resource. A request is granted only when its permissions are a subset and its lifetime is within max_lifetime_seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "service", "resource", "permissions", "max_lifetime_seconds"],
      "properties": {
        "subject": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 256},
        "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "max_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "config": {
      "title": "Employee access configuration (version 1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "cloudflare_access", "launcher", "grants"],
      "properties": {
        "version": {"const": 1},
        "url": {"type": "string", "pattern": "^https?://", "description": "Where employee processes reach the facade (the Cloudflare Access application hostname)."},
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 0, "maximum": 65535}
          }
        },
        "cloudflare_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "audience"],
          "properties": {
            "issuer": {"type": "string", "pattern": "^https?://", "description": "Pinned token issuer; JWKS is fetched from <issuer>/cdn-cgi/access/certs."},
            "audience": {"type": "string", "minLength": 1, "description": "The Access application AUD tag."}
          }
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signing_key_ref", "public_key"],
          "properties": {
            "signing_key_ref": {"type": "string", "pattern": "^op://", "description": "1Password reference to the Ed25519 PKCS8 private key. Resolved only inside the trusted launcher."},
            "public_key": {"type": "string", "minLength": 1, "description": "Ed25519 SPKI PEM used by the facade to verify run assertions."}
          }
        },
        "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}}
      }
    }
  }
}
